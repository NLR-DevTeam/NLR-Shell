+// imePush sends the editor state and commits it, which makes the compositor
+// forward it to the input method.
+func (w *window) imePush() {
+	im := w.textInput()
+	if im == nil || !w.ime.shown {
+		return
+	}
+	hint, purpose := imeContentType(w.ime.hint)
+	C.zwp_text_input_v3_set_content_type(im, hint, purpose)
+	state := w.w.EditorState()
+	// text-input-v3 counts bytes; the editor tracks runes.
+	sn := state.Snippet
+	off := func(rune int) int { return byteIndex(sn.Text, rune-sn.Start) }
+	text := C.CString(sn.Text)
+	defer C.free(unsafe.Pointer(text))
+	C.zwp_text_input_v3_set_surrounding_text(im, text,
+		C.int32_t(off(state.Selection.Range.Start)), C.int32_t(off(state.Selection.Range.End)))
+	if r, ok := w.imeCaretRect(state); ok {
+		C.zwp_text_input_v3_set_cursor_rectangle(im,
+			C.int32_t(r.Min.X), C.int32_t(r.Min.Y), C.int32_t(r.Dx()), C.int32_t(r.Dy()))
+	}
+	C.zwp_text_input_v3_commit(im)
+}
