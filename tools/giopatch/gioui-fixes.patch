+	const XIMStyle pref[3] = {XIMPreeditPosition, XIMPreeditCallbacks, XIMPreeditNothing};
+	for (size_t k = 0; k < 3; k++) {
+		for (unsigned short i = 0; i < styles->count_styles; i++) {
+			XIMStyle st = styles->supported_styles[i];
+			if ((st & pref[k]) == pref[k] && (st & XIMStatusNothing) == XIMStatusNothing) {
+				want[nwant++] = st;
