+// applyTextInput hands the input method's pending preedit or commit to the
+// editor, following the other platforms.
+func (w *window) applyTextInput() {
+	state := w.w.EditorState()
+	rng := state.compose
+	if rng.Start == -1 {
+		rng = state.Selection.Range
+	}
+	switch {
+	case w.ime.commit != "":
+		w.w.EditorReplace(rng, w.ime.commit)
+		w.w.SetComposingRegion(key.Range{Start: -1, End: -1})
+		pos := min(rng.Start, rng.End) + utf8.RuneCountInString(w.ime.commit)
+		w.w.SetEditorSelection(key.Range{Start: pos, End: pos})
+	case w.ime.preedit != "":
+		w.w.EditorReplace(rng, w.ime.preedit)
+		comp := key.Range{Start: rng.Start, End: rng.Start + utf8.RuneCountInString(w.ime.preedit)}
+		w.w.SetComposingRegion(comp)
+		w.w.SetEditorSelection(key.Range{Start: comp.End, End: comp.End})
+	default:
+		// The preedit was withdrawn without a commit.
+		if state.compose.Start >= 0 {
+			w.w.EditorReplace(state.compose, "")
+			w.w.SetComposingRegion(key.Range{Start: -1, End: -1})
+		}
+	}
+	w.ime.preedit, w.ime.commit = "", ""
+}
+
+// imeCancel drops the text the input method composed so far.
+func (w *window) imeCancel() {
+	state := w.w.EditorState()
+	if state.compose.Start >= 0 {
+		w.w.EditorReplace(state.compose, "")
+	}
+	w.w.SetComposingRegion(key.Range{Start: -1, End: -1})
+}
